<?xml version="1.0" encoding="utf-8"?>
<config>
    <allow-association target="com.samsung.android.smartsuggestions" allowed="io.mesalabs.unica.localsummary" />
    <allow-association target="io.mesalabs.unica.localsummary" allowed="com.samsung.android.smartsuggestions" />
    <allow-association target="io.mesalabs.unica.localsummary" allowed="android" />
    <allow-association target="io.mesalabs.rezoss.qwen" allowed="io.mesalabs.unica.localsummary" />
    <allow-association target="io.mesalabs.unica.localsummary" allowed="io.mesalabs.rezoss.qwen" />
    <!-- Keep existing peers; permit the shared V73 service/model-provider path. -->
    <allow-association target="io.mesalabs.unica.localsummary" allowed="com.samsung.android.aioskernelservice" />
    <allow-association target="io.mesalabs.rezoss.qwen" allowed="com.samsung.android.aioskernelservice" />
    <allow-association target="com.samsung.android.aioskernelservice" allowed="com.samsung.android.ssco" />
    <allow-association target="com.samsung.android.ssco" allowed="com.samsung.android.aioskernelservice" />
    <!-- Declaring a target restricts its peers. Keep the Samsung callers and
         existing local-summary consumer alongside the new SSCO inference link. -->
    <allow-association target="com.samsung.android.aioskernelservice" allowed="com.samsung.android.offline.languagemodel" />
    <allow-association target="com.samsung.android.aioskernelservice" allowed="io.mesalabs.unica.localsummary" />
    <allow-association target="com.samsung.android.aioskernelservice" allowed="io.mesalabs.rezoss.qwen" />
    <allow-association target="com.samsung.android.ssco" allowed="com.samsung.android.aicore" />
    <allow-association target="com.samsung.android.ssco" allowed="com.samsung.android.smartsuggestions" />
    <!-- Settings search reads SemanticDataProvider while indexing device Q&A. -->
    <allow-association target="com.samsung.android.ssco" allowed="com.android.settings.intelligence" />
    <!-- Experimental AIOS model import uses Android's user-selected storage provider. -->
    <allow-association target="com.samsung.android.aioskernelservice" allowed="com.android.externalstorage" />
    <!-- The picker's Download, Images/Videos and Recent roots are served by these providers.
         Only list them as peers of aioskernelservice: AMS checks both sides, and declaring
         a system provider as a target locks every other app (My Files, Storage share,
         Gallery, ...) out of it. -->
    <allow-association target="com.samsung.android.aioskernelservice" allowed="com.android.providers.downloads" />
    <allow-association target="com.samsung.android.aioskernelservice" allowed="com.android.providers.media.module" />
    <allow-association target="com.samsung.android.aioskernelservice" allowed="com.google.android.providers.media.module" />
    <allow-association target="com.samsung.android.aioskernelservice" allowed="com.android.providers.media" />
</config>

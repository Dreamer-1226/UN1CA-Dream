(type unica_troubleshooting)
(roletype object_r unica_troubleshooting)
(typeattributeset domain (unica_troubleshooting))
(typeattributeset coredomain (unica_troubleshooting))
(type unica_troubleshooting_exec)
(roletype object_r unica_troubleshooting_exec)
(typeattributeset file_type (unica_troubleshooting_exec))
(typeattributeset exec_type (unica_troubleshooting_exec))
(typeattributeset system_file_type (unica_troubleshooting_exec))
(allow init unica_troubleshooting_exec (file (read open getattr map execute)))
(allow init unica_troubleshooting (process (transition siginh rlimitinh)))
(allow unica_troubleshooting init (process (sigchld)))
(allow unica_troubleshooting init (fd (use)))
(allow unica_troubleshooting unica_troubleshooting_exec (file (read open getattr map execute entrypoint)))
(type unica_troubleshooting_data)
(type unica_troubleshooting_request)
(type unica_troubleshooting_response)
(roletype object_r unica_troubleshooting_data)
(roletype object_r unica_troubleshooting_request)
(roletype object_r unica_troubleshooting_response)
(typeattributeset file_type (unica_troubleshooting_data unica_troubleshooting_request unica_troubleshooting_response))
(typeattributeset data_file_type (unica_troubleshooting_data unica_troubleshooting_request unica_troubleshooting_response))
(typeattributeset core_data_file_type (unica_troubleshooting_data unica_troubleshooting_request unica_troubleshooting_response))
(type unica_troubleshooting_prop)
(roletype object_r unica_troubleshooting_prop)
(typeattributeset property_type (unica_troubleshooting_prop))
(typeattributeset system_property_type (unica_troubleshooting_prop))
(typeattributeset system_internal_property_type (unica_troubleshooting_prop))
(allow system_app unica_troubleshooting_data (dir (search getattr)))
(allow system_app unica_troubleshooting_request (dir (search read open getattr write add_name remove_name)))
(allow system_app unica_troubleshooting_request (file (create read write open getattr setattr rename unlink)))
(allow system_app unica_troubleshooting_response (dir (search read open getattr)))
(allow system_app unica_troubleshooting_response (file (read open getattr)))
(allow system_app unica_troubleshooting_prop (property_service (set)))
(allow system_app unica_troubleshooting_prop (file (read open getattr map)))
(allow unica_troubleshooting system_data_file (dir (search getattr)))
(allow unica_troubleshooting unica_troubleshooting_data (dir (search getattr)))
(allow unica_troubleshooting unica_troubleshooting_request (dir (search read open getattr)))
(allow unica_troubleshooting unica_troubleshooting_request (file (read open getattr)))
(allow unica_troubleshooting unica_troubleshooting_response (dir (search read open getattr write add_name remove_name)))
(allow unica_troubleshooting unica_troubleshooting_response (file (create read write open getattr setattr rename unlink lock)))

; Root is a UID, not an SELinux bypass. Only this fixed native worker accesses root-module storage.
(allow unica_troubleshooting system_data_file (dir (search getattr)))
(allow unica_troubleshooting adb_data_file (dir (search read open getattr write add_name remove_name)))
(allow unica_troubleshooting adb_data_file (file (read open getattr create write unlink)))
(allow unica_troubleshooting unica_troubleshooting_data (dir (search read open getattr write add_name)))
(allow unica_troubleshooting unica_troubleshooting_data (file (create read write open getattr lock)))
(allow unica_troubleshooting unica_troubleshooting_response (file (setattr)))
(allow unica_troubleshooting self (capability (chown)))
(allow unica_troubleshooting system_file (file (read open getattr map)))
(allow unica_troubleshooting system_file (dir (search getattr)))
(allow unica_troubleshooting tmpfs (file (read write open getattr)))
(allow unica_troubleshooting null_device (chr_file (read write open getattr)))
(allow system_app property_socket (sock_file (write)))
(allow system_app init (unix_stream_socket (connectto)))

; O_PATH traversal of /data; no directory enumeration is required.
(allow unica_troubleshooting system_data_root_file (dir (search getattr)))
; SQLite operates only on private copies of the LSPosed DB/WAL, never the live DB.
(allow unica_troubleshooting unica_troubleshooting_data (dir (create remove_name rmdir)))
(allow unica_troubleshooting unica_troubleshooting_data (file (setattr unlink map)))
(allow unica_troubleshooting system_lib_file (file (read open getattr map execute)))
